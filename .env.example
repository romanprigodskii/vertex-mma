DATABASE_URL=postgresql://user:password@host:5432/database

# postgres-js connection-pool ceiling, per app instance. Dev: 3 (also safe for
# Turbopack HMR, which leaks a pool per reload). Production single-instance:
# 8-10 so force-dynamic pages — which fan out ~8 queries per request — don't
# queue behind too few slots and inflate p95. Hard limit: the sum across all
# instances must not exceed the session-pooler's 15 slots (e.g. 2 instances →
# ~7 each). Unset/invalid falls back to the safe default of 3.
DB_POOL_MAX=3

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin — used for metadataBase (OG/Twitter images),
# sitemap URLs, and the auth-callback redirect. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://vertexmma.com

# Anthropic API key — required by the news classification pipeline.
ANTHROPIC_API_KEY=

# Staff/moderator allowlist — comma-separated emails. These users can remove
# any comment (trust & safety). Leave blank for none.
ADMIN_EMAILS=
