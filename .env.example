DATABASE_URL=postgresql://user:password@host:5432/database

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin — used for metadataBase (OG/Twitter images),
# sitemap URLs, and the auth-callback redirect. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://vertexmma.com

# Anthropic API key — required by the news classification pipeline.
ANTHROPIC_API_KEY=

# Staff/moderator allowlist — comma-separated emails. These users can remove
# any comment (trust & safety). Leave blank for none.
ADMIN_EMAILS=
