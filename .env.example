# Postgres is self-hosted on the VPS and bound to localhost there, so local
# development goes through an SSH tunnel:
#   ssh -i ~/.ssh/vertexmma_vps_ed25519 -fNL 5434:127.0.0.1:5433 root@<vps>
DATABASE_URL=postgresql://user:password@host:5432/database

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin — used for metadataBase (OG/Twitter images),
# sitemap URLs, and the auth-callback redirect. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://vertexmma.com

# Photo scraper only — where fetched photos are staged before being rsynced to
# the origin in ops/photos. Defaults to ~/.cache/vertexmma-photos.
PHOTO_STORE_DIR=

# Anthropic API key — required by the news classification pipeline.
ANTHROPIC_API_KEY=

# Staff/moderator allowlist — comma-separated emails. These users can remove
# any comment (trust & safety). Leave blank for none.
ADMIN_EMAILS=
