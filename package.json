{
  "name": "vertex-mma",
  "version": "0.1.0",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/db/seed.ts",
    "scrape:setup": "cd scripts/scraper && python3 -m venv venv && ./venv/bin/pip install -r requirements.txt",
    "scrape:quick": "cd scripts/scraper && ./venv/bin/python scripts/run_all.py --phase quick",
    "scrape:enrich": "cd scripts/scraper && ./venv/bin/python scripts/run_all.py --phase enrich",
    "scrape:all": "cd scripts/scraper && ./venv/bin/python scripts/run_all.py --phase all",
    "scrape:country": "cd scripts/scraper && ./venv/bin/python scripts/06_backfill_country.py",
    "scrape:country:dry": "cd scripts/scraper && ./venv/bin/python scripts/06_backfill_country.py --dry-run --limit 5 --workers 1",
    "scrape:scorecards": "cd scripts/scraper && ./venv/bin/python scripts/07_scrape_scorecards.py",
    "scrape:scorecards:dry": "cd scripts/scraper && ./venv/bin/python scripts/07_scrape_scorecards.py --dry-run --limit 5",
    "photos:setup": "cd scripts/photo_scraper && python3 -m venv venv && ./venv/bin/pip install -r requirements.txt",
    "photos:dry": "cd scripts/photo_scraper && ./venv/bin/python scripts/fetch_photos.py --limit 5 --dry-run",
    "photos:fetch": "cd scripts/photo_scraper && ./venv/bin/python scripts/fetch_photos.py --workers 4",
    "roster:import": "tsx scripts/import_roster_watch.ts",
    "markets:generate": "tsx scripts/generate_markets.ts",
    "markets:generate:dry": "tsx scripts/generate_markets.ts --limit=5",
    "markets:settle": "tsx scripts/settle_market.ts",
    "markets:refund": "tsx scripts/refund_market.ts",
    "markets:reseed": "tsx scripts/reseed_market_prices.ts",
    "odds:scrape": "cd scripts/scraper && ./venv/bin/python scripts/08_scrape_bestfightodds.py",
    "odds:scrape:dry": "cd scripts/scraper && ./venv/bin/python scripts/08_scrape_bestfightodds.py --dry-run --limit 5",
    "odds:sync": "pnpm odds:scrape && tsx scripts/sync_market_odds.ts",
    "news:scrape": "cd scripts/scraper && ./venv/bin/python scripts/09_scrape_news.py",
    "news:extract": "cd scripts/scraper && ./venv/bin/python scripts/09b_extract_article_bodies.py",
    "news:classify": "cd scripts/scraper && ./venv/bin/python scripts/10_classify_news.py",
    "news:rephrase": "cd scripts/scraper && ./venv/bin/python scripts/11_rephrase_news.py",
    "news:ingest": "pnpm news:scrape && pnpm news:extract && pnpm news:classify && pnpm news:rephrase",
    "news:watch": "tsx scripts/news_watch.ts",
    "predictions:generate": "tsx scripts/generate_prediction_events.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
